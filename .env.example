# Apna actual values yahan likhna .env.local file mein, ye file sirf example hai

# Supabase pooler connection string (IPv4 compatible)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# NextAuth secret - generate karne ke liye: openssl rand -base64 32
AUTH_SECRET="koi-bhi-random-string-32-character-ka"

# NextAuth URL - local mein http://localhost:3000, Render par https://your-app.onrender.com
NEXTAUTH_URL="http://localhost:3000"

# Anthropic AI key
ANTHROPIC_API_KEY="sk-ant-..."
